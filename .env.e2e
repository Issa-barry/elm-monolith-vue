# ========================================
# ENV DÉDIÉ AUX TESTS E2E (Playwright)
# ========================================
# Chargé par `php artisan serve --env=e2e` (voir playwright.config.ts).
# Base de données séparée de la BDD de dev (elm-monolithe) : les scénarios
# E2E créent de vraies données via l'UI (transferts, commissions, paiements...)
# et NE DOIVENT JAMAIS écrire dans la base de dev. `npm run e2e` recrée cette
# base à partir de zéro (migrate:fresh --seed) avant chaque run.
APP_NAME="Eau-la-maman [E2E]"
APP_ENV=e2e
APP_KEY=base64:28KosRZz/JD80s63hn6PmLqvLAt6Ck/GkjqLAWEnVGw=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

# ========================================
# BASE DE DONNÉES — isolée de la BDD de dev
# ========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elm_monolithe_e2e
DB_USERNAME=root
DB_PASSWORD=

# ========================================
# CACHE / SESSION / QUEUE
# ========================================
# SESSION_DRIVER=file (pas "array") : les tests E2E pilotent un vrai navigateur
# via HTTP, la session doit survivre entre deux requêtes distinctes.
CACHE_STORE=file
# Isole storage/framework/cache/data du dev (cf. config/cache.php) : sans ça, le
# rate limiter de connexion (clé telephone|ip) est partagé avec le serveur de
# dev — un login E2E échoué peut déclencher "Trop de tentatives" pour l'utilisateur
# en train de développer, sur son propre serveur, au même moment.
CACHE_PATH_SUFFIX=-e2e
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=array

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
DEBUGBAR_ENABLED=false
BCRYPT_ROUNDS=4

OTP_FIXED_CODE=123456
VITRINE_SERVICE_TOKEN=testing-vitrine-token

# Thème par défaut distinct (cf. docs/theming.md) — purement visuel, aucun
# test E2E n'affirme sur une couleur. Pas de THEME_ALLOWED_* : tout le
# catalogue reste autorisé, comme en local.
THEME_DEFAULT_PRESET=starter
THEME_DEFAULT_PRIMARY=orange
THEME_DEFAULT_SURFACE=zinc
WEB_REGISTRATION_ENABLED=false
MOBILE_CLIENT_SCHEME=mobile
