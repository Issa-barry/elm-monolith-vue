## Gabarit pour l'environnement de PREPROD (formation.eau-la-maman.com).
## Ne PAS copier le .env d'un autre environnement (prod ou local) : partir toujours
## de ce fichier, cf. README pour la procédure de déploiement.
## Différences volontaires par rapport à .env.production.example :
##  - APP_ENV=preprod (pas "production") pour que app()->environment('production')
##    reste réservé à la vraie prod (ex: RolesAndPermissionsSeeder ne crée les
##    comptes de démo que si APP_ENV != production).
##  - LOG_LEVEL=debug pour faciliter le diagnostic pendant les tests.
##  - MAIL_MAILER=log pour ne jamais envoyer de vrais emails aux clients depuis
##    un environnement de test.

APP_NAME="Eau-la-maman [PREPROD]"
APP_ENV=preprod
APP_KEY=
APP_DEBUG=false
APP_URL=https://formation.eau-la-maman.com
DEBUGBAR_ENABLED=false

# Clé requise pour accéder à l'assistant d'installation web (/install) — à définir avant le
# 1er déploiement, ne jamais committer sa valeur réelle. Sans cette variable,
# le wizard web refuse tout accès (utiliser `php artisan app:install` en CLI à la place).
APP_INSTALL_TOKEN=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# aura | lara | material | nora | starter
VITE_PRIMEVUE_THEME=starter
VITE_PRIMEVUE_PRIMARY=blue
VITE_PRIMEVUE_SURFACE=slate

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=preprod
# Plan Sentry gratuit = quota partagé avec la prod au niveau de l'organisation (même avec un
# projet séparé). On reste économe ici pour ne pas grignoter le quota réservé à la vraie prod.
SENTRY_TRACES_SAMPLE_RATE=0.1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis non requis sur cet hebergement

# log = aucun envoi réel, les emails atterrissent dans storage/logs/laravel.log.
# Repasser en smtp uniquement si un test d'envoi réel est explicitement nécessaire.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
