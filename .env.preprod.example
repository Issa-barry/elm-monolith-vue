## Gabarit pour l'environnement de PREPROD (formation.eau-la-maman.com).
## Objectif : iso à 100% avec la prod (mêmes chemins de code, même comportement Laravel), pour que
## ce qui est validé ici soit fiable avant la vraie MEP. Les données de démo/test vivent dans un
## environnement séparé, pas ici — ne jamais lancer un seeder de démo sur ce fichier.
## Ne PAS copier le .env d'un autre environnement (prod ou local) : partir toujours de ce
## fichier, cf. README pour la procédure de déploiement.
##
## Seules 4 différences volontaires avec .env.production.example (tout le reste est identique
## exprès) :
##  - APP_URL / DB_* / APP_NAME pointent sur l'hébergement preprod, pas prod.
##  - MAIL_MAILER=log : seule dérogation à l'iso, pour ne jamais envoyer de vrais emails à de
##    vrais clients depuis un environnement de test.
##  - THEME_ALLOWED_* / THEME_DEFAULT_* : politique de thème volontairement différente (cf.
##    docs/theming.md) — jamais bleu ni sa famille visuelle ici, pour que le bleu reste un repère
##    fiable de la vraie prod. La valeur active reste choisie par un admin dans /settings/theme,
##    ce bloc ne fait que fixer ce qui est proposable.
##  - API_DOCS_ENABLED=true (contre false en prod) : la documentation OpenAPI reste accessible
##    au staff autorisé ici, pour valider le contrat avant la vraie MEP.
## APP_ENV reste "production" (comme la vraie prod) : c'est justement ce qui garantit qu'aucun
## compte de démo n'est créé si un seeder est lancé par erreur ici (cf.
## RolesAndPermissionsSeeder::run(), seul endroit du code qui teste app()->environment('production')).
## La distinction preprod/prod dans le monitoring se fait via SENTRY_ENVIRONMENT uniquement
## (variable indépendante d'APP_ENV).

APP_NAME="Eau-la-maman [PREPROD]"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://formation.eau-la-maman.com
DEBUGBAR_ENABLED=false

# Clé requise pour accéder à l'assistant d'installation web (/install) — à définir avant le
# 1er déploiement, ne jamais committer sa valeur réelle. Sans cette variable,
# le wizard web refuse tout accès (utiliser `php artisan app:install` en CLI à la place).
APP_INSTALL_TOKEN=

# Documentation OpenAPI (/docs/api, /docs/vitrine) accessible au staff autorisé (Gate
# viewApiDocs) — utile pour valider le contrat API avant la vraie MEP. Fermé par défaut si
# cette variable est absente : ne jamais la retirer par erreur en copiant un autre .env.
API_DOCS_ENABLED=true

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Thème global : jamais bleu ni sa famille visuelle (sky/cyan/indigo) hors
# production — cf. note en tête de fichier et docs/theming.md.
THEME_ALLOWED_PRESETS=starter,aura,lara,material,nora
THEME_ALLOWED_PRIMARIES=emerald,green,lime,yellow,amber,orange,violet,purple,fuchsia,pink,rose
THEME_ALLOWED_SURFACES=zinc,slate,stone,neutral,gray
THEME_DEFAULT_PRESET=starter
THEME_DEFAULT_PRIMARY=emerald
THEME_DEFAULT_SURFACE=slate

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

SENTRY_LARAVEL_DSN=
# Seule variable qui distingue preprod de la prod aux yeux du monitoring — APP_ENV, lui, reste
# "production" à l'identique (voir note en tête de fichier).
SENTRY_ENVIRONMENT=preprod
# Plan Sentry gratuit = quota partagé avec la prod au niveau de l'organisation (même avec un
# projet séparé). On reste économe ici pour ne pas grignoter le quota réservé à la vraie prod.
SENTRY_TRACES_SAMPLE_RATE=0.1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Durée de vie des tokens Sanctum (API mobile + futurs clients), en minutes.
# 129600 = 90 jours par défaut (cf. config/sanctum.php).
SANCTUM_EXPIRATION_MINUTES=129600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Redis non requis sur cet hebergement

# log = aucun envoi réel, les emails atterrissent dans storage/logs/laravel.log.
# Repasser en smtp uniquement si un test d'envoi réel est explicitement nécessaire.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
