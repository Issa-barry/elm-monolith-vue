APP_NAME=Eau-la-maman
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_VERSION=
APP_RELEASED_AT=

# Clé requise pour accéder à l'assistant d'installation web (/install) — ne jamais committer sa
# valeur réelle. En on_premise, optionnelle mais recommandée dès la production (sans elle,
# /install reste ouvert jusqu'à la 1ère installation, qui le referme définitivement). En saas,
# OBLIGATOIRE : /install y reste accessible indéfiniment, donc sans cette clé l'app refuse tout
# accès à /install (500) plutôt que de rester ouverte sans protection.
APP_INSTALL_TOKEN=

# on_premise (défaut) : /install se ferme dès qu'une organisation a été installée (redirige
# vers /login ensuite). saas : /install reste accessible indéfiniment pour créer de nouvelles
# organisations — dans ce cas APP_INSTALL_TOKEN ci-dessus est obligatoire.
#APP_DEPLOYMENT_MODE=on_premise
APP_DEPLOYMENT_MODE=saas

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Laisser vide en local : DSN vide = Sentry totalement désactivé (aucun appel réseau).
# Ne jamais coller ici le DSN de prod/preprod en copiant un autre .env.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=1.0

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CONTACT_MAIL_TO=contact@eaulamaman.com

# Secret partagé server-to-server pour les routes api/public/* (voir
# VerifyVitrineServiceToken) — appelées uniquement par l'app vitrine.
VITRINE_SERVICE_TOKEN=
# URL publique de la vitrine (eau-la-maman.com) — sert uniquement à rediriger
# les anciens liens publics du back-office (ex: /register/livreur).
VITRINE_APP_URL=https://eau-la-maman.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_SHOW_ENTITY_STATS_CARDS=false

# Thème global (preset/couleur/surface) — politique par déploiement, cf.
# docs/theming.md. THEME_ALLOWED_* absent = tout le catalogue autorisé.
THEME_DEFAULT_PRESET=starter
THEME_DEFAULT_PRIMARY=blue
THEME_DEFAULT_SURFACE=slate
